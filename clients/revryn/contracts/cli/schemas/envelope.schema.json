{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revryn.github.io/billing-core/clients/revryn/contracts/cli/schemas/envelope.schema.json",
  "title": "revryn.v1 output envelopes",
  "description": "Stable machine-readable envelopes emitted by revryn --json. Success envelopes go to stdout, error envelopes to stderr. The command-specific payload shape under data is documented by the golden examples in ../golden and derives from schema/billing_core.graphql.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": ["data", "correlationId", "schema"],
      "properties": {
        "data": {
          "description": "Command-specific payload; see the golden examples."
        },
        "correlationId": { "type": "string", "minLength": 1 },
        "schema": { "const": "revryn.v1" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["error", "schema"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["kind", "message", "exitCode"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "usage", "auth", "not_found", "validation", "mapping",
                "version_conflict", "idempotency_conflict", "transport",
                "graphql", "generic"
              ]
            },
            "code": { "type": "string" },
            "message": { "type": "string" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "code", "message"],
                "properties": {
                  "path": { "type": "array", "items": { "type": "string" } },
                  "code": { "type": "string" },
                  "message": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "exitCode": { "type": "integer", "minimum": 1, "maximum": 7 }
          },
          "additionalProperties": false
        },
        "correlationId": { "type": "string" },
        "schema": { "const": "revryn.v1" }
      },
      "additionalProperties": false
    }
  }
}
